rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function canAccessAssessment(assessmentId) {
      let assessment = get(/databases/$(database)/documents/assessments/$(assessmentId));
      return isSignedIn() && (
        assessment.data.ownerId == request.auth.uid ||
        request.auth.uid in assessment.data.memberIds
      );
    }

    function isAssessmentOwner(assessmentId) {
      return isSignedIn() &&
        get(/databases/$(database)/documents/assessments/$(assessmentId)).data.ownerId == request.auth.uid;
    }

    function isAssessmentTask(task) {
      return task.parentType == 'assessment';
    }

    function hasOnlyAssessmentMembers(assessmentId, assigneeIds) {
      let assessment = get(/databases/$(database)/documents/assessments/$(assessmentId));
      return assigneeIds is list &&
        assigneeIds.toSet().difference(
          assessment.data.memberIds.toSet().union([assessment.data.ownerId].toSet())
        ).size() == 0;
    }

    // 1. Users Collection
    match /users/{uid} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create, update: if isOwner(uid) && request.resource.data.uid == request.auth.uid;
      allow delete: if false;
    }

    // 2. Master Tasks Collection
    match /tasks/{taskId} {
      allow get, list: if isSignedIn() && (
        (isAssessmentTask(resource.data) && canAccessAssessment(resource.data.parentId)) ||
        (!isAssessmentTask(resource.data) && (
          resource.data.ownerId == request.auth.uid ||
          request.auth.uid in resource.data.assignedToUserIds
        ))
      );
      allow create: if isSignedIn() &&
        request.resource.data.ownerId == request.auth.uid &&
        request.resource.data.title is string &&
        request.resource.data.title.size() > 0 &&
        request.resource.data.title.size() <= 300 &&
        (
          !isAssessmentTask(request.resource.data) ||
          (canAccessAssessment(request.resource.data.parentId) &&
            hasOnlyAssessmentMembers(request.resource.data.parentId, request.resource.data.assignedToUserIds))
        );
      allow update: if isSignedIn() && (
        (
          !isAssessmentTask(resource.data) &&
          resource.data.ownerId == request.auth.uid &&
          request.resource.data.ownerId == resource.data.ownerId
        ) ||
        (
          isAssessmentTask(resource.data) &&
          request.resource.data.ownerId == resource.data.ownerId &&
          request.resource.data.parentType == resource.data.parentType &&
          request.resource.data.parentId == resource.data.parentId &&
          canAccessAssessment(resource.data.parentId) &&
          hasOnlyAssessmentMembers(resource.data.parentId, request.resource.data.assignedToUserIds)
        ) ||
        (
          !isAssessmentTask(resource.data) &&
          request.auth.uid in resource.data.assignedToUserIds &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['completed', 'completedAt'])
        )
      );
      allow delete: if isSignedIn() && (
        (!isAssessmentTask(resource.data) && resource.data.ownerId == request.auth.uid) ||
        (isAssessmentTask(resource.data) && isAssessmentOwner(resource.data.parentId))
      );
    }

    // 3. Academic Assessments Collection
    match /assessments/{assessmentId} {
      allow get: if isSignedIn() && (
        resource.data.ownerId == request.auth.uid ||
        request.auth.uid in resource.data.memberIds
      );
      allow list: if isSignedIn() && (
        resource.data.ownerId == request.auth.uid ||
        request.auth.uid in resource.data.memberIds
      );
      allow create: if isSignedIn() &&
        request.resource.data.ownerId == request.auth.uid &&
        request.resource.data.name is string &&
        request.resource.data.name.size() <= 200;
      allow update: if isSignedIn() &&
        resource.data.ownerId == request.auth.uid &&
        request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;
    }

    // 4. Assessment Notes Collection
    match /assessmentNotes/{noteId} {
      allow get, list: if canAccessAssessment(resource.data.assessmentId);
      allow create: if canAccessAssessment(request.resource.data.assessmentId) &&
        request.resource.data.assessmentId is string &&
        request.resource.data.items is list &&
        request.resource.data.authorId == request.auth.uid;
      allow update, delete: if canAccessAssessment(resource.data.assessmentId) &&
        (isAssessmentOwner(resource.data.assessmentId) || resource.data.authorId == request.auth.uid);
    }

    // 5. Assessment Resources Collection
    match /assessmentResources/{resourceId} {
      allow get, list: if canAccessAssessment(resource.data.assessmentId);
      allow create: if canAccessAssessment(request.resource.data.assessmentId) &&
        request.resource.data.assessmentId is string &&
        request.resource.data.title is string &&
        request.resource.data.url is string;
      allow update, delete: if canAccessAssessment(resource.data.assessmentId);
    }

    // 6. Work Items Collection (Classes and Events)
    match /workItems/{workItemId} {
      allow get, list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isSignedIn() &&
        resource.data.ownerId == request.auth.uid &&
        request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;
    }

    // 7. Work Occurrences Collection (Individual session instances/overrides)
    match /workOccurrences/{occurrenceId} {
      allow get, list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isSignedIn() &&
        resource.data.ownerId == request.auth.uid &&
        request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;
    }

    // 8. Projects Collection
    match /projects/{projectId} {
      allow get, list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isSignedIn() &&
        resource.data.ownerId == request.auth.uid &&
        request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;
    }

    // 9. Dedicated Collaboration Codes Lookup Collection
    match /collaborationCodes/{code} {
      // Direct get by exact code is allowed; listing all codes is never allowed.
      allow get: if isSignedIn() && (resource == null || resource.data.enabled == true);
      // Listing or querying all codes is strictly forbidden
      allow list: if false;
      allow create: if isSignedIn() &&
        request.resource.data.ownerId == request.auth.uid &&
        request.resource.data.code == code &&
        get(/databases/$(database)/documents/assessments/$(request.resource.data.assessmentId)).data.ownerId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;
    }
  }
}
