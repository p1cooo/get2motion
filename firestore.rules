rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function canAccessAssessment(assessmentId) {
      let assessment = get(/databases/$(database)/documents/assessments/$(assessmentId));
      return isSignedIn() && (
        assessment.data.ownerId == request.auth.uid ||
        request.auth.uid in assessment.data.memberIds
      );
    }

    // 1. Users Collection
    match /users/{uid} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create, update: if isOwner(uid) && request.resource.data.uid == request.auth.uid;
      allow delete: if false;
    }

    // 2. Master Tasks Collection
    match /tasks/{taskId} {
      allow get: if isSignedIn() && (
        resource.data.ownerId == request.auth.uid ||
        request.auth.uid in resource.data.assignedToUserIds
      );
      allow list: if isSignedIn() && (
        resource.data.ownerId == request.auth.uid ||
        request.auth.uid in resource.data.assignedToUserIds
      );
      allow create: if isSignedIn() &&
        request.resource.data.ownerId == request.auth.uid &&
        request.resource.data.title is string &&
        request.resource.data.title.size() > 0 &&
        request.resource.data.title.size() <= 300;
      allow update: if isSignedIn() && (
        (resource.data.ownerId == request.auth.uid && request.resource.data.ownerId == resource.data.ownerId) ||
        (
          request.auth.uid in resource.data.assignedToUserIds &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['completed', 'completedAt'])
        )
      );
      allow delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;
    }

    // 3. Academic Assessments Collection
    match /assessments/{assessmentId} {
      allow get: if isSignedIn() && (
        resource.data.ownerId == request.auth.uid ||
        request.auth.uid in resource.data.memberIds
      );
      allow list: if isSignedIn() && (
        resource.data.ownerId == request.auth.uid ||
        request.auth.uid in resource.data.memberIds
      );
      allow create: if isSignedIn() &&
        request.resource.data.ownerId == request.auth.uid &&
        request.resource.data.name is string &&
        request.resource.data.name.size() <= 200;
      allow update: if isSignedIn() && (
        // Standard Owner Update
        (resource.data.ownerId == request.auth.uid && request.resource.data.ownerId == resource.data.ownerId) ||
        // Secure Collaboration Join (Code verified, only adds caller's UID)
        (
          resource.data.collaborationEnabled == true &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds']) &&
          request.resource.data.memberIds.toSet().difference(resource.data.memberIds.toSet()) == [request.auth.uid].toSet() &&
          request.resource.data.collaborationCode == resource.data.collaborationCode
        )
      );
      allow delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;
    }

    // 4. Assessment Notes Collection
    match /assessmentNotes/{noteId} {
      allow get, list: if canAccessAssessment(resource.data.assessmentId);
      allow create: if canAccessAssessment(request.resource.data.assessmentId) &&
        request.resource.data.assessmentId is string &&
        request.resource.data.items is list &&
        request.resource.data.authorId == request.auth.uid;
      allow update, delete: if canAccessAssessment(resource.data.assessmentId) &&
        (resource.data.authorId == request.auth.uid);
    }

    // 5. Assessment Resources Collection
    match /assessmentResources/{resourceId} {
      allow get, list: if canAccessAssessment(resource.data.assessmentId);
      allow create: if canAccessAssessment(request.resource.data.assessmentId) &&
        request.resource.data.assessmentId is string &&
        request.resource.data.title is string &&
        request.resource.data.url is string;
      allow update, delete: if canAccessAssessment(resource.data.assessmentId);
    }

    // 6. Work Items Collection (Classes and Events)
    match /workItems/{workItemId} {
      allow get, list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isSignedIn() &&
        resource.data.ownerId == request.auth.uid &&
        request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;
    }

    // 7. Work Occurrences Collection (Individual session instances/overrides)
    match /workOccurrences/{occurrenceId} {
      allow get, list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isSignedIn() &&
        resource.data.ownerId == request.auth.uid &&
        request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;
    }

    // 8. Projects Collection
    match /projects/{projectId} {
      allow get, list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isSignedIn() &&
        resource.data.ownerId == request.auth.uid &&
        request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;
    }

    // 9. Dedicated Collaboration Codes Lookup Collection
    match /collaborationCodes/{code} {
      // Direct get by exact code is allowed if code is enabled
      allow get: if isSignedIn() && (resource == null || resource.data.enabled == true);
      // Listing or querying all codes is strictly forbidden
      allow list: if false;
      allow create, update, delete: if isSignedIn() && (
        resource == null ? request.resource.data.ownerId == request.auth.uid : resource.data.ownerId == request.auth.uid
      );
    }
  }
}
